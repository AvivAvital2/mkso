__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
.mkso/
dist/
build/

# Operator credentials: never stage local environment files.
.env
.env.*
!.env.example

# Operator key material and local identity records are never repository inputs.
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.pub
id_rsa
id_dsa
id_ecdsa
id_ed25519
/public/
/bootstrap/baseline/deployment/approval-provisioning-request.json

# This public source snapshot has an explicit top-level publication boundary.
/*
!/.dockerignore
!/.env.example
!/.gitignore
!/.python-version
!/README.md
!/pyproject.toml
!/uv.lock
!/mkso/
!/tests/
!/bootstrap/
!/implementation/
!/toolchain/

# Never stage project planning, private evidence, or historical draft archives.
*.md
!/README.md
!/mkso/_schema/README.md
*.review.*
*.plan.*
*.observation.json
*.scip
*.b64
**/artifacts/
**/tasks/
**/review/
**/qualification/
**/patches/
**/predecessor/
**/candidate/
/bootstrap/atomic/
/bootstrap/design-ledger/
/bootstrap/baseline/deployment/implementor-runtime/deployment.json
